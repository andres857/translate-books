DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=./data

# ---- Método de traducción (se elige en Administración › Configuración; aquí solo valores iniciales)
# API de DeepSeek: empieza por sk-; también se puede escribir desde la web
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
# razonamiento del modelo al traducir: disabled (más rápido) | low | high (más cuidadoso) | max
DEEPSEEK_THINKING=high
# Suscripción de Claude (Pro/Max) dentro de Docker: ejecuta `claude setup-token` en tu equipo y pega aquí
# el token (sk-ant-oat…), o pégalo en la web. No es una llave de API: consume el uso de tu suscripción.
CLAUDE_CODE_OAUTH_TOKEN=
# ruta del programa claude si no está en el PATH (desarrollo local)
# CLAUDE_BIN=claude

MAX_UPLOAD_MB=200
TRANSLATION_CONCURRENCY=10
MIN_FONT_SCALE=0.75
MIN_FONT_SIZE_PT=5.5
# true = traductor falso sin API (para probar maquetación/interfaz sin gastar tokens)
FAKE_TRANSLATOR=false
CORS_ORIGINS=http://localhost:3000
# ruta de ebook-convert (Calibre, para descargar AZW3) si no está en el PATH
# EBOOK_CONVERT_BIN=ebook-convert

# ---- Docker compose
# puertos publicados en el host (cambia WEB_PORT si el 3000 está ocupado)
WEB_PORT=3000
API_PORT=8000
# UID/GID del dueño de ./data en el host (id -u / id -g)
APP_UID=1000
APP_GID=1000
