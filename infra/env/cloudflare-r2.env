# Cloudflare R2. Región "auto". R2 NO soporta ACL por objeto: el acceso público se da
# conectando un dominio propio al bucket o activando el subdominio r2.dev.
# CORS: panel de R2 › Settings › CORS policy (o `python -m app.storage.setup`).
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_INTERNAL_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=mi-bucket
S3_ACCESS_KEY=...
S3_SECRET_KEY=...
S3_FORCE_PATH_STYLE=true
# https://pub-<hash>.r2.dev o tu dominio propio (sin el nombre del bucket en la ruta)
PUBLIC_BASE_URL=https://archivos.midominio.com
