# AWS S3. Sin endpoint (boto3 usa el de la región); virtual-hosted style.
# Acceso público: política de bucket (s3:GetObject) o, mejor, CloudFront delante con OAC.
# CORS del bucket: consola/IaC, o `python -m app.storage.setup` con estas variables.
# En Docker, vacía también S3_INTERNAL_ENDPOINT y S3_PUBLIC_ENDPOINT (el compose pone los de SeaweedFS).
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_INTERNAL_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=eu-west-1
S3_BUCKET=mi-bucket
S3_ACCESS_KEY=AKIA...
S3_SECRET_KEY=...
S3_FORCE_PATH_STYLE=false
# CloudFront o el dominio del bucket
PUBLIC_BASE_URL=https://dxxxxxxxx.cloudfront.net
