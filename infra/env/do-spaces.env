# DigitalOcean Spaces. Endpoint regional; virtual-hosted style.
# Acceso público: activa el CDN de Spaces y "File listing"/permisos a nivel de Space (no ACL por objeto).
STORAGE_DRIVER=s3
S3_ENDPOINT=https://fra1.digitaloceanspaces.com
S3_INTERNAL_ENDPOINT=https://fra1.digitaloceanspaces.com
S3_PUBLIC_ENDPOINT=https://fra1.digitaloceanspaces.com
S3_REGION=fra1
S3_BUCKET=mi-space
S3_ACCESS_KEY=DO00...
S3_SECRET_KEY=...
S3_FORCE_PATH_STYLE=false
# endpoint CDN del Space (o tu dominio propio)
PUBLIC_BASE_URL=https://mi-space.fra1.cdn.digitaloceanspaces.com
